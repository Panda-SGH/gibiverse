# Database
DATABASE_URL="db-connection-string"

# Better Auth
# BETTER_AUTH_URL must be the browser-facing origin (e.g. Next.js on :3000),
# not the internal Hono port. Google OAuth redirect_uri is derived from this.
BETTER_AUTH_SECRET="your-32-byte-secret"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000,http://localhost:3001"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
