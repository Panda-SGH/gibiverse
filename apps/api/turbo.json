{
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": ["DATABASE_URL", "PORT"]
    },
    "dev": {
      "env": ["DATABASE_URL", "PORT"],
      "passThroughEnv": ["DATABASE_URL", "PORT"]
    },
    "typecheck": {
      "env": ["DATABASE_URL"]
    },
    "test": {
      "env": [
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_TRUSTED_ORIGINS",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET"
      ],
      "passThroughEnv": [
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_TRUSTED_ORIGINS",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET"
      ]
    }
  }
}
